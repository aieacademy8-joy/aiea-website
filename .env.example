# Portal runtime: server reads these browser-safe project values.
# Supply only in an explicitly approved environment; no hosted setup in 01B.
PORTAL_SUPABASE_URL=
PORTAL_SUPABASE_PUBLISHABLE_KEY=
# Approved application origin, e.g. http://localhost:4321 for disposable local tests.
PORTAL_ORIGIN=
# Server only. Never prefix with PUBLIC_, NEXT_PUBLIC_, or VITE_.
PORTAL_SUPABASE_SECRET_KEY=
# The ordinary-adult Sprint 01B runtime does NOT read this secret key.
# Future server-trusted commerce configuration; no live checkout wiring:
PORTAL_STRIPE_ENVIRONMENT=test
PORTAL_STRIPE_ACCOUNT_ID=
PORTAL_STRIPE_WEBHOOK_SECRET=
# Exact offer -> Stripe Product/Price -> published program_version mapping
# belongs in reviewed server configuration, never browser-supplied metadata.
# Direct database credentials are NOT needed by the public website.
